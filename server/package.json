{
  "name": "builddeck-server",
  "version": "1.0.0",
  "description": "BuildDeck Backend API, Worker, and Real-Time Service",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "worker": "node src/workers/environmentWorker.js",
    "cleanup": "node src/workers/cleanupWorker.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "seed": "node prisma/seed.js",
    "test": "jest --runInBand --forceExit",
    "test:e2e": "node tests/e2e.test.js"
  },
  "dependencies": {
    "@octokit/rest": "^20.1.1",
    "@prisma/client": "^5.14.0",
    "axios": "^1.7.2",
    "cookie-session": "^2.1.0",
    "cors": "^2.8.5",
    "dockerode": "^4.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "socket.io": "^4.7.5",
    "tar-fs": "^3.0.5",
    "tar-stream": "^3.1.7",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "prisma": "^5.14.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000
  }
}
