# ==============================================================================
# BuildDeck Environment Configuration
# ==============================================================================

# Server Port
PORT=5000
NODE_ENV=development

# Database Connection (MySQL 8.0 with Prisma)
DATABASE_URL=mysql://root:password@localhost:3306/builddeck

# GitHub OAuth Credentials
# Create a GitHub OAuth App at https://github.com/settings/developers
# Homepage URL: http://localhost:5173
# Authorization callback URL: http://localhost:5000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub Webhook Secret
# Set the same secret in your GitHub repository webhook settings
GITHUB_WEBHOOK_SECRET=builddeck_webhook_secret_key_12345

# Session & Cookie Encryption Secret
SESSION_SECRET=super_secret_builddeck_session_key_987654321

# Frontend URL (For CORS and OAuth redirects)
FRONTEND_URL=http://localhost:5173

# Traefik Reverse Proxy & Domain Settings
TRAEFIK_HOST=localhost
PREVIEW_DOMAIN=preview.localhost

# Container Health Check Settings
PREVIEW_HEALTH_PATH=/health
PREVIEW_STARTUP_TIMEOUT=120000

# Container Resource Limits
PREVIEW_MEMORY_LIMIT=512m
PREVIEW_CPU_LIMIT=1
PREVIEW_PIDS_LIMIT=100

# Maximum Environment Lifetime (seconds) before automated cleanup (3600 = 1 hour)
PREVIEW_MAX_LIFETIME=3600

# Optional Docker Host configuration
# On Windows, Dockerode automatically detects //./pipe/docker_engine
# On Linux/macOS, it automatically detects /var/run/docker.sock
# DOCKER_HOST=
# DOCKER_SOCKET_PATH=
